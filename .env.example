HOLD_THRESHOLD=0.35

# --- Phase 4: real phone calls (optional) ---
# Leave blank to keep the browser-based callback. All four are required, plus
# CALLBACK_AUTO_CALL=1 for automatic dialing. Real calls also require
# CALLBACK_DEMO=0 and CALLBACK_API_PASSWORD.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PUBLIC_BASE_URL=
CALLBACK_AUTO_CALL=0

# Demo is the default. Live mode requires a password and signed phone recordings.
# Use HTTPS for remote access. Basic auth accepts any username with this password.
CALLBACK_DEMO=1
CALLBACK_API_PASSWORD=
