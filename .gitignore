# SQLite, including the write-ahead log and shared-memory files. The WAL held a
# Twilio Account SID and was blocked by GitHub push protection -- '*.sqlite'
# alone does not match 'callback.sqlite-wal'.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
data/callback.sqlite*
